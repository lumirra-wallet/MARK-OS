        h2 { color: #34495e; margin-top: 30px; }
        h3 { color: #7f8c8d; }
        code { background: #f4f4f4; padding: 2px 6px; border-radius: 3px; }
        pre { background: #f8f8f8; padding: 15px; border-radius: 5px; overflow-x: auto; }
        .note { background: #e8f4fd; border-left: 4px solid #3498db; padding: 15px; margin: 15px 0; }
        .warning { background: #fef0d5; border-left: 4px solid #f39c12; padding: 15px; margin: 15px 0; }
