# Copy this file to .env.local and fill in the values.
#
# MARK Dashboard — environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# API endpoint for the MARK Python server.
# - Local development:  set this to http://localhost:8000
# - Replit / same-host: leave EMPTY (the dashboard will call same origin)
# - VPS / Docker:       set to the public URL of your MARK server
#
VITE_API_URL=http://localhost:8000
