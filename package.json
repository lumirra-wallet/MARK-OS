{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "concurrently --names \"BUILD,API\" --prefix-colors \"yellow,cyan\" \"pnpm --filter @workspace/mark-dashboard run build:watch\" \"pnpm --filter @workspace/mark-api run dev\"",
    "dev:split": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,magenta\" \"pnpm --filter @workspace/mark-api run dev\" \"pnpm --filter @workspace/mark-dashboard run dev\"",
    "dev:backend": "pnpm --filter @workspace/mark-api run dev",
    "dev:frontend": "pnpm --filter @workspace/mark-dashboard run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "concurrently": "^10.0.3"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
