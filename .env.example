# ── MARK AI OS — Environment Configuration ────────────────────────────────────
#
# Copy this file to .env and fill in the values.
# All variables are optional; MARK uses sensible defaults.
#
#   cp .env.example .env
#
# MARK selects the best provider automatically:
#   1. ACTIVE_PROVIDER (explicit override)
#   2. NVIDIA_API_KEY present → NVIDIA
#   3. GITHUB_TOKEN present  → GitHub Models
#   4. OPENAI_API_KEY present → OpenAI
#   5. ANTHROPIC_API_KEY present → Anthropic
#   6. Default               → Ollama (local)
# ──────────────────────────────────────────────────────────────────────────────


# ── Provider selection ─────────────────────────────────────────────────────────
# Explicit provider override. Remove to use auto-detection.
# Values: nvidia | github | openai | anthropic | ollama
ACTIVE_PROVIDER=


# ── NVIDIA ────────────────────────────────────────────────────────────────────
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=
# Optional: default model (default: nvidia/nemotron-3-ultra-550b-a55b)
NVIDIA_DEFAULT_MODEL=


# ── GitHub Models ──────────────────────────────────────────────────────────────
# Get a token at https://github.com/settings/tokens
# Required scope: models:read (or public_repo for older endpoints)
GITHUB_TOKEN=


# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional: override the base URL for Azure OpenAI or compatible endpoints
OPENAI_BASE_URL=
# Optional: default model (default: gpt-4o-mini)
OPENAI_DEFAULT_MODEL=


# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional: default model (default: claude-3-5-haiku-20241022)
ANTHROPIC_DEFAULT_MODEL=


# ── Ollama (local) ────────────────────────────────────────────────────────────
# Default: http://localhost:11434
OLLAMA_HOST=
# Default models (must be pulled first: ollama pull llama3.1:8b)
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b


# ── Database ──────────────────────────────────────────────────────────────────
# Values: sqlite (default) | postgres
DATABASE_PROVIDER=sqlite
# Required when DATABASE_PROVIDER=postgres
DATABASE_URL=
# Example: DATABASE_URL=postgresql://user:pass@localhost:5432/mark


# ── Vector store ──────────────────────────────────────────────────────────────
# Values: keyword (default, no deps) | chroma | pgvector
VECTOR_PROVIDER=keyword
# ChromaDB persistence path (when VECTOR_PROVIDER=chroma)
CHROMA_PATH=.mark_chroma
CHROMA_COLLECTION=mark_knowledge
# Embedding dimension (default 1536 = text-embedding-3-small)
EMBEDDING_DIM=1536


# ── Storage ───────────────────────────────────────────────────────────────────
# Directory for local JSON storage files
STORAGE_DIR=.mark_storage


# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
SESSION_SECRET=change-me-in-production
# Used in startup logs and link generation (auto-set on Replit)
API_BASE_URL=


# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the dashboard uses to reach the Python backend.
# Leave blank on Replit (auto-detected from window.location.origin + /mark-api)
# Set to http://localhost:8000 for standalone local dev
VITE_API_URL=
