# ── Elena / MSART OS — environment configuration example ─────────────────────
# Copy this file to .env and fill in your values.
# Secrets (API keys) should be set via Replit Secrets, not committed to .env.

# ── Active provider (which LLM to use for Elena's reasoning) ─────────────────
# Options: ollama | github | nvidia | openai | anthropic
ACTIVE_PROVIDER=ollama

# ── Database ─────────────────────────────────────────────────────────────────
# Options: mongodb | postgres | sqlite (default: sqlite for local dev)
DATABASE_PROVIDER=sqlite
MONGODB_URI=mongodb://localhost:27017/msart

# ── Ollama (local LLM — default voice reasoning) ─────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── NVIDIA NIM (fast cloud voice reasoning) ──────────────────────────────────
NVIDIA_API_KEY=nvapi-...

# ── GitHub Models (alternative cloud provider) ────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── Google Gemini Live (real-time voice transport) ───────────────────────────
# When set, the Gemini Live provider becomes available in the voice settings.
GOOGLE_LIVE_API_KEY=AIza...
# Model to use for Gemini Live sessions (default: gemini-2.0-flash-live-001)
GOOGLE_LIVE_MODEL=gemini-2.0-flash-live-001
# Gemini Live built-in voice name (Aoede | Charon | Fenrir | Kore | Puck | Zephyr)
# Aoede is the warmest female voice — closest to Elena's character.
VOICE_NAME=Aoede

# ── LiveKit (self-hosted WebRTC voice transport — optional) ───────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── Default active reasoning model ───────────────────────────────────────────
# Used when ACTIVE_PROVIDER supports multiple models (e.g. github/nvidia).
MARK_MODEL=

# ── API base URL (set by Replit automatically, override for custom domains) ───
# API_BASE_URL=https://your-domain.repl.co
